<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentLoop</RootNamespace>
    <AssemblyName>lunima-agent-loop</AssemblyName>
    <Version>0.1.0</Version>
    <!-- `dotnet publish` produces one native executable: no .NET runtime needed on the target,
         fast start. Needs the platform C/C++ toolchain on the build machine (MSVC on Windows). -->
    <PublishAot>true</PublishAot>
    <!-- no ICU at runtime (minimal Linux hosts); the tool only formats/parses ISO dates and numbers -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Compiled into the binary so a published exe runs standalone; files on disk still win. -->
    <EmbeddedResource Include="prompts\*.md" LogicalName="prompts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="agent-loop.example.json" LogicalName="agent-loop.example.json" />
  </ItemGroup>

</Project>
